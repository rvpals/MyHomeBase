{
  "name": "myhomebase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean:next && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:lib-boundary": "node scripts/check-lib-boundary.mjs",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "gen:icons": "node scripts/gen-icon-glyphs.mjs",
    "gen:splash": "node scripts/gen-splash.mjs",
    "publish:nas": "node scripts/publish-nas.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:migrate:dry-run": "tsx --env-file-if-exists=.env scripts/migration-dry-run.ts",
    "verify:prepare-db": "tsx --env-file-if-exists=.env scripts/prepare-smoke-db.ts",
    "verify:preflight": "node scripts/verify-preflight.mjs",
    "verify": "npm run clean:next && npm run typecheck && npm run lint && npm run check:lib-boundary && npm test && npm run db:migrate:dry-run && npm run verify:preflight && npm run verify:prepare-db && npm run test:e2e",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "leaflet": "^1.9.4",
    "music-metadata": "^11.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify-json/fluent-emoji-flat": "^1.2.5",
    "@iconify-json/hugeicons": "^1.2.31",
    "@iconify-json/lucide": "^1.2.118",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/streamline-color": "^1.2.2",
    "@iconify-json/tabler": "^1.2.38",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
