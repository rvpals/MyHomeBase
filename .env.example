# Copy to .env.local (gitignored) and fill in real values. Never commit real secrets.

# Optional: override the SQLite database file location.
# MYHOMEBASE_DB=./data/myhomebase.db

# Optional: the Music Library module's root folder (absolute, read-only).
#   dev (Windows): //NAS_DS223/MEDIA/AUDIO
#   NAS:           /volume1/MEDIA/AUDIO
# MYHOMEBASE_MUSIC_ROOT=

# The journal's photo archive is configured IN THE APP, not here: My Journal ->
# Configuration -> Photo folder, which has a "Check Access" button that reports what the
# app can actually read at that path. Each install needs its own value, and an env var
# could only be corrected by editing this file and restarting.
# This variable is still read as a fallback for an install that predates the setting.
# MYHOMEBASE_PHOTO_ROOT=

# "Sign in with Google" is disabled unless all three of these are set.
# Set up in Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Application type: Web application.
# Add an "Authorized redirect URI" that matches GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
# Example for local dev: http://localhost:3000/login/google/callback
GOOGLE_REDIRECT_URI=

# Property lookup / watch list is disabled unless this is set.
# Sign up at https://www.rentcast.io/ to get an API key.
RENTCAST_API_KEY=

# Optional. When set, a visitor on the "Create account" screen who enters this
# exact value in the (hidden) "Admin secret key" field is created as an admin
# instead of a normal user. Leave blank to disable admin self-signup entirely.
ADMIN_SIGNUP_SECRET=
